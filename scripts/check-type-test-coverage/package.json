{
  "name": "check-type-test-coverage",
  "version": "1.0.0",
  "type": "module",
  "description": "Report which exported .d.ts declarations are covered by a sibling *.test-d.ts",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "check-type-test-coverage": "index.js"
  },
  "scripts": {
    "test": "cross-env FORCE_COLOR=1 node --test test/*.test.js",
    "test:coverage": "cross-env FORCE_COLOR=1 node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=index.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
