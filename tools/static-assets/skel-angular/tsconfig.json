{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2022",
    "lib": ["es2020", "dom"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,

    /* Module Resolution Options */
    "module": "preserve",
    "types": ["node", "mocha"],
    "baseUrl": ".",
    "paths": {
      /* Support absolute /imports/* with a leading '/' */
      "/*": ["*"],
      /* Native declarations generated by `meteor types`. */
      "meteor/*": ["./.meteor/types/packages/*"]
    },
  },
  "files": ["./.meteor/types/packages.d.ts"],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "exclude": [
    "./.meteor/**",
    "./packages/**",
    "./_build/**",
    "./public/build-chunks/**",
    "./public/build-assets/**"
  ]
}
