{
  // see https://guide.meteor.com/build-tool.html#typescript for a config example
  "compilerOptions": {
    "allowSyntheticDefaultImports": true, // to be able to import eg meteor/mongo
    "module": "esNext",
    "moduleResolution": "bundler",
    "paths": {
      "/*": ["./*"], // support absolute /imports/* with a leading '/'
      // Native declarations generated by `meteor types`.
      "meteor/*": ["./.meteor/types/packages/*"]
    },
    "preserveSymlinks": true,
    "verbatimModuleSyntax": true // preserve imports used by Svelte components
  },
  "files": ["./.meteor/types/packages.d.ts"],
  "include": ["**/*"],
  "exclude": ["./.meteor/**", "./packages/**"]
}
