{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2018",
    "module": "esNext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,

    /* Module Resolution Options */
    "paths": {
      /* Support absolute /imports/* with a leading '/' */
      "/*": ["./*"],
      /* Keep the existing @types/meteor + zodern behavior while zodern:types
         is installed. If it is removed, Meteor's generated per-package
         adapters and barrel become the native provider. */
      "meteor/*": [
        "./.meteor/types/packages/*",
        "./node_modules/@types/meteor/*",
        "./.meteor/types/packages.d.ts",
        "./.meteor/local/types/packages.d.ts"
      ]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "esModuleInterop": true,
    "preserveSymlinks": true,
    "skipLibCheck": true
  },
  "exclude": [
    "./.meteor/**",
    "./packages/**",
    "./_build/**",
    "./public/build-chunks/**",
    "./public/build-assets/**"
  ]
}
