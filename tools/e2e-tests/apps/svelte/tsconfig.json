{
  // see https://guide.meteor.com/build-tool.html#typescript for a config example
  "compilerOptions": {
    "allowSyntheticDefaultImports": true, // to be able to import eg meteor/mongo
    "baseUrl": ".", // required by "paths"
    "module": "esNext",
    "moduleResolution": "bundler",
    "paths": {
      "/*": ["*"], // support absolute /imports/* with a leading '/'
      // Meteor's built-in type generator writes per-package adapters and a
      // sub-path barrel automatically. @types/meteor stays as a fallback.
      "meteor/*": [
        ".meteor/types/packages/*",
        "node_modules/@types/meteor/*",
        ".meteor/types/packages.d.ts"
      ]
    },
    "verbatimModuleSyntax": true // otherwise TS will remove imported components
  },
  "exclude": [
    "./.meteor/local/isopacks/**",
    "./.meteor/local/plugin-cache/**",
    "./packages/**"
  ]
}
